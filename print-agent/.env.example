# Copy this file to .env and fill in the printer's real IP address.

# The printer's LAN IP (Ethernet connection). Give it a static/reserved IP
# on your router so it doesn't change.
PRINTER_HOST=192.168.1.50

# Standard raw ESC/POS socket port. Almost never needs changing.
PRINTER_PORT=9100

# Port the agent itself listens on (the web app talks to this on localhost).
AGENT_PORT=7777

# Printable width in dots. 576 is the standard printable width for an 80mm
# printer at 203dpi (the paper is 80mm, but printers leave a small margin).
# Only change this if receipts print cut off or with a large blank margin.
RECEIPT_WIDTH_PX=576

# Set to true to test everything (rendering, image conversion, ESC/POS
# framing) WITHOUT a printer connected. Each print job is written to
# last-receipt.bin instead of being sent over the network.
DRY_RUN=false

# Set to true to also save the rendered receipt as last-receipt.png next to
# last-receipt.bin, for visually checking what will print.
DEBUG_SAVE_PNG=false

# Optional: path to a Chrome/Chromium executable. Leave unset to use the
# system Chrome/Edge (playwright-core's `channel: "chrome"` mode) — that
# works if Chrome is already installed on this PC, which is the common case.
# Only set this if that doesn't work (e.g. no Chrome installed, or Linux
# server without a desktop browser) after running `npx playwright install
# chromium` — see README.
# PRINT_AGENT_CHROME_PATH=
