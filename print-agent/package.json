{
  "name": "marasi-print-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local ESC/POS print agent for the Marasi Alsawadi counter thermal printer. Runs on the counter PC, never deployed to Hetzner.",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jimp": "^1.6.1",
    "playwright-core": "^1.62.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
