# Core runtime
NODE_ENV=production
PORT=3000
DATABASE_URL=mysql://MARASI_DB_USER:MARASI_DB_PASSWORD@MARASI_DB_HOST:3306/marasi_erp
PUBLIC_APP_URL=https://erp.example.om

# Local authentication
# Generate a unique high-entropy value for this Marasi deployment only.
SESSION_SECRET=replace-with-a-long-random-value
SESSION_TTL_MINUTES=720

# One-time Super Admin bootstrap. Remove these variables from Coolify after
# running `pnpm auth:bootstrap` successfully.
BOOTSTRAP_SUPER_ADMIN_USERNAME=owner
BOOTSTRAP_SUPER_ADMIN_PASSWORD=replace-with-a-temporary-12-character-password
BOOTSTRAP_SUPER_ADMIN_NAME=Resort Owner
BOOTSTRAP_SUPER_ADMIN_EMAIL=owner@example.om

# No other project’s variables, database URL, domain, volume, or secrets may be
# copied into this application. WhatsApp is outside the current quoted phase.
