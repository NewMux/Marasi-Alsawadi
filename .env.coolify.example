# Core runtime
NODE_ENV=production
PORT=3000
DATABASE_URL=mysql://USER:PASSWORD@MYSQL_HOST:3306/marasi_erp
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Self-hosted OIDC for staff sign-in — leave unset until the providers are configured.
AUTH_BASE_URL=https://erp.example.om
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=organizations
AUTH_ALLOWED_EMAILS=

# Do not carry Manus-only OAuth or Forge credentials to Hetzner.
# OAUTH_SERVER_URL=
# VITE_OAUTH_PORTAL_URL=
# BUILT_IN_FORGE_API_URL=
# BUILT_IN_FORGE_API_KEY=
