# Core runtime
NODE_ENV=production
PORT=3000
DATABASE_URL=mysql://USER:PASSWORD@MYSQL_HOST:3306/marasi_erp

# Public ticket pages and QR codes
PUBLIC_APP_URL=https://erp.example.om

# This deployment runs without a login wall by design: every request acts as
# a single auto-provisioned system user, and WhatsApp ticket delivery is
# disabled. Re-adding either is a deliberate future change, not a missing
# config value here.
